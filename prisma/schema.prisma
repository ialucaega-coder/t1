// Esquema de base de datos de Local B (plataforma SaaS de reservas y gestión de negocios)
// Motor: PostgreSQL | ORM: Prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Roles de usuario dentro de un negocio
enum Role {
  ADMIN
  PROFESSIONAL
  CLIENT
}

// Estados posibles de una reserva
enum BookingStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

// Origen desde donde se creó la reserva
enum BookingSource {
  WEB
  TELEGRAM
  WHATSAPP
  VOICE
  WALK_IN
}

// Estados posibles de un pedido de productos
enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY
  DELIVERED
  CANCELLED
}

// Tipo de movimiento contable
enum TransactionType {
  SALE
  REFUND
  PARTIAL
}

// Métodos de pago soportados
enum PaymentMethod {
  CASH
  CARD
  TRANSFER
  QR
}

// Tipos de notificación del sistema
enum NotificationType {
  BOOKING_CREATED
  BOOKING_CONFIRMED
  BOOKING_REMINDER
  BOOKING_CANCELLED
  ORDER_STATUS
  PROMOTION
  GENERAL
}

// Canales de envío de notificaciones
enum NotificationChannel {
  EMAIL
  WHATSAPP
  TELEGRAM
  SMS
  PUSH
}

// Negocio (tenant) de la plataforma. Todas las entidades cuelgan de un Business
// para soportar multi-tenant (multi-negocio) sobre el mismo esquema.
model Business {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  logo        String?
  coverImage  String?
  phone       String?
  email       String?
  address     String?
  city        String?
  country     String?
  timezone    String   @default("America/Argentina/Buenos_Aires")
  currency    String   @default("ARS")
  theme       String   @default("onyx")
  accentColor String   @default("#38BDF8") // Celeste (sky blue) por defecto
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users         User[]
  professionals Professional[]
  services      Service[]
  bookings      Booking[]
  products      Product[]
  orders        Order[]
  promotions    Promotion[]
  transactions  Transaction[]
  notifications Notification[]
  schedules     Schedule[]
  categories    Category[]
  skills        Skill[]
  commands      Command[]
  connections   Connection[]
  templates     Template[]

  @@map("businesses")
}

// Usuario de la plataforma. Cubre administradores, profesionales y clientes
// (el rol CLIENT es el "Client" de negocio: quien reserva turnos y hace pedidos).
model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  phone        String?
  avatar       String?
  role         Role      @default(CLIENT)
  isActive     Boolean   @default(true)
  failedLogins Int       @default(0)
  lockedUntil  DateTime?
  lastLoginAt  DateTime?
  deletedAt    DateTime? // Borrado lógico (soft delete) para clientes
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  professional     Professional?
  bookingsAsClient Booking[]      @relation("ClientBookings")
  orders           Order[]
  notifications    Notification[]

  // Índices para búsquedas frecuentes de clientes por negocio, email y teléfono
  @@index([businessId])
  @@index([email])
  @@index([phone])
  @@map("users")
}

// Profesional que presta servicios dentro de un negocio (vinculado 1 a 1 con User)
model Professional {
  id          String   @id @default(cuid())
  bio         String?
  specialties String[]
  isAvailable Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  schedules Schedule[]
  bookings  Booking[]
  services  Service[]  @relation("ProfessionalServices")

  // Índice para listar profesionales por negocio
  @@index([businessId])
  @@map("professionals")
}

// Horario semanal de disponibilidad de un profesional
model Schedule {
  id        String  @id @default(cuid())
  dayOfWeek Int
  startTime String
  endTime   String
  isActive  Boolean @default(true)

  professionalId String
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  // Evita horarios duplicados para el mismo profesional y día
  @@unique([professionalId, dayOfWeek, startTime])
  @@index([professionalId])
  @@map("schedules")
}

// Categoría para agrupar servicios y productos
model Category {
  id        String  @id @default(cuid())
  name      String
  icon      String?
  sortOrder Int     @default(0)

  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  services Service[]
  products Product[]

  @@index([businessId])
  @@map("categories")
}

// Servicio ofrecido por el negocio (ej: corte de pelo, color, etc.)
model Service {
  id          String    @id @default(cuid())
  name        String
  description String?
  duration    Int // Duración en minutos
  price       Decimal   @db.Decimal(10, 2) // Decimal para precisión monetaria
  currency    String    @default("ARS")
  image       String?
  isActive    Boolean   @default(true)
  sortOrder   Int       @default(0)
  deletedAt   DateTime? // Borrado lógico (soft delete)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  professionals Professional[] @relation("ProfessionalServices")
  bookings      Booking[]

  // Índices para listados por negocio (activos) y por categoría
  @@index([businessId, isActive])
  @@index([categoryId])
  @@map("services")
}

// Reserva de un turno para un servicio con un profesional
model Booking {
  id         String        @id @default(cuid())
  date       DateTime
  startTime  String
  endTime    String
  status     BookingStatus @default(PENDING)
  source     BookingSource @default(WEB)
  notes      String?
  totalPrice Decimal       @db.Decimal(10, 2) // Decimal para precisión monetaria
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  clientId String
  client   User   @relation("ClientBookings", fields: [clientId], references: [id])

  professionalId String
  professional   Professional @relation(fields: [professionalId], references: [id])

  serviceId String
  service   Service @relation(fields: [serviceId], references: [id])

  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  // Índices para las consultas más frecuentes: agenda por negocio/fecha,
  // agenda por profesional/fecha, historial por cliente y filtros por estado
  @@index([businessId, date])
  @@index([professionalId, date])
  @@index([clientId])
  @@index([status])
  @@map("bookings")
}

// Producto físico en venta (ej: shampoo, cera, etc.)
model Product {
  id          String    @id @default(cuid())
  name        String
  description String?
  price       Decimal   @db.Decimal(10, 2) // Decimal para precisión monetaria
  stock       Int       @default(0)
  image       String?
  isActive    Boolean   @default(true)
  sortOrder   Int       @default(0)
  deletedAt   DateTime? // Borrado lógico (soft delete)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  orderItems OrderItem[]

  // Índices para listados por negocio (activos) y por categoría
  @@index([businessId, isActive])
  @@index([categoryId])
  @@map("products")
}

// Pedido de productos realizado por un cliente
model Order {
  id         String      @id @default(cuid())
  status     OrderStatus @default(PENDING)
  totalPrice Decimal     @db.Decimal(10, 2) // Decimal para precisión monetaria
  notes      String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  clientId String
  client   User   @relation(fields: [clientId], references: [id])

  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  items        OrderItem[]
  transactions Transaction[]

  // Índices para listados por negocio/fecha, historial por cliente y filtros por estado
  @@index([businessId, createdAt])
  @@index([clientId])
  @@index([status])
  @@map("orders")
}

// Línea de detalle de un pedido (producto + cantidad + precio al momento de la compra)
model OrderItem {
  id       String  @id @default(cuid())
  quantity Int
  price    Decimal @db.Decimal(10, 2) // Decimal para precisión monetaria

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

// Promoción o descuento aplicable a servicios/productos del negocio
model Promotion {
  id          String   @id @default(cuid())
  name        String
  description String?
  discount    Decimal  @db.Decimal(10, 2) // Decimal: puede ser monto fijo o porcentaje
  isPercent   Boolean  @default(true)
  code        String?  @unique
  startDate   DateTime
  endDate     DateTime
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, isActive])
  @@map("promotions")
}

// Movimiento contable (venta, reembolso, pago parcial) del negocio
model Transaction {
  id            String          @id @default(cuid())
  amount        Decimal         @db.Decimal(10, 2) // Decimal para precisión monetaria
  type          TransactionType @default(SALE)
  paymentMethod PaymentMethod   @default(CASH)
  reference     String?
  notes         String?
  createdAt     DateTime        @default(now())

  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  // Relación opcional con el pedido que originó la transacción (venta de productos)
  orderId String?
  order   Order?  @relation(fields: [orderId], references: [id])

  // Índices para reportes por negocio/fecha y para ubicar transacciones de un pedido
  @@index([businessId, createdAt])
  @@index([orderId])
  @@map("transactions")
}

// Notificación enviada a un usuario (recordatorios de turno, estado de pedido, promos, etc.)
model Notification {
  id        String              @id @default(cuid())
  type      NotificationType
  channel   NotificationChannel
  title     String
  body      String
  isRead    Boolean             @default(false)
  sentAt    DateTime?
  createdAt DateTime            @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  // Índices para bandeja de notificaciones (no leídas) por negocio y por usuario
  @@index([businessId, isRead])
  @@index([userId])
  @@map("notifications")
}

// Habilidad/skill configurable del asistente del negocio
model Skill {
  id          String  @id @default(cuid())
  name        String
  description String?
  icon        String?
  isActive    Boolean @default(true)
  config      Json?

  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@map("skills")
}

// Comando/atajo configurable del negocio
model Command {
  id          String  @id @default(cuid())
  name        String
  description String?
  template    String
  category    String?
  sortOrder   Int     @default(0)

  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@map("commands")
}

// Integración/conexión externa configurada por el negocio (ej: WhatsApp, Telegram)
model Connection {
  id       String  @id @default(cuid())
  name     String
  type     String
  icon     String?
  config   Json?
  isActive Boolean @default(false)

  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@map("connections")
}

// Plantilla de mensaje/contenido reutilizable del negocio
model Template {
  id          String  @id @default(cuid())
  name        String
  description String?
  type        String
  content     String
  category    String?

  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@map("templates")
}
