# apps/server/.env.example
# Variables de entorno del backend Express (apps/server).
# Copia este archivo a ".env" y completa los valores reales.
# NUNCA subas el archivo ".env" real al control de versiones.

# ---------------------------------------------------------------------------
# Base de datos (Prisma / PostgreSQL)
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://user:password@localhost:5432/localb?schema=public"
# Conexion directa (sin pooler) — usada por Prisma para migraciones.
DIRECT_URL="postgresql://user:password@localhost:5432/localb?schema=public"

# ---------------------------------------------------------------------------
# Redis — OPCIONAL. Habilita escalado horizontal (multi-instancia):
#   - Rate limiting distribuido (conteo compartido entre réplicas).
#   - Adaptador de Socket.IO (eventos en tiempo real entre réplicas).
# Si se deja vacío/sin definir, el sistema usa fallbacks en memoria (single-node).
# ---------------------------------------------------------------------------
REDIS_URL="redis://localhost:6379"

# ---------------------------------------------------------------------------
# Autenticacion — debe coincidir con NEXTAUTH_SECRET del frontend (apps/web)
# porque ambos servicios firman/verifican el mismo JWT.
# Generar con: openssl rand -base64 32
# ---------------------------------------------------------------------------
NEXTAUTH_SECRET="your-secret-here"
# TTL del JWT de sesión (formato de vercel/ms: '7d', '14d', '12h'). Default '14d'.
# Bajalo (ej. '7d') para reducir la ventana de un token filtrado.
JWT_EXPIRES_IN="14d"
# Clave para cifrar secretos en reposo (ej. el secreto TOTP de 2FA, AES-256-GCM).
# Si no se setea, se deriva de NEXTAUTH_SECRET. En producción, usá una dedicada.
# Generar con: openssl rand -base64 32
ENCRYPTION_KEY=""

# ---------------------------------------------------------------------------
# CORS / Socket.io — origen permitido del frontend
# ---------------------------------------------------------------------------
FRONTEND_URL="http://localhost:3000"
# Orígenes adicionales permitidos (CORS), separados por coma. Útil para varios
# dominios de frontend (ej. staging + prod). Los localhost ya se permiten en dev.
FRONTEND_URLS="https://app.tudominio.com,https://admin.tudominio.com"

# ---------------------------------------------------------------------------
# Servidor
# ---------------------------------------------------------------------------
PORT=4000
NODE_ENV=development
# Saltos de proxy de confianza para X-Forwarded-For (rate limit por IP real).
# 0 = no confiar (default, evita spoofing sin proxy). En Cloud Run: 1.
TRUST_PROXY_HOPS=0
# Scheduler de superpoderes (reportes/recordatorios diarios). Los cron viven en
# memoria del proceso: si escalás a >1 instancia, poné RUN_SCHEDULER=false en
# TODAS menos UNA para no duplicar notificaciones. Default (sin setear): corre.
# RUN_SCHEDULER=false

# ---------------------------------------------------------------------------
# Proveedor de IA por defecto (chatbot / asistente)
# Valores soportados: "anthropic" | "openai"
# ---------------------------------------------------------------------------
AI_PROVIDER="anthropic"
ANTHROPIC_API_KEY="your-anthropic-key"
ANTHROPIC_MODEL="claude-sonnet-4-5"
OPENAI_API_KEY="your-openai-key"
OPENAI_MODEL="gpt-4o-mini"

# ---------------------------------------------------------------------------
# URL pública del backend — usada para armar URLs de webhooks (ej. Telegram).
# En producción, la URL de Cloud Run (ej. https://api.tudominio.com).
# ---------------------------------------------------------------------------
API_PUBLIC_URL="http://localhost:4000"

# ---------------------------------------------------------------------------
# Telegram Bot — canal de reservas via Telegram
# ---------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN="your-telegram-bot-token"

# ---------------------------------------------------------------------------
# WhatsApp Business API — canal de reservas via WhatsApp
# ---------------------------------------------------------------------------
WHATSAPP_TOKEN="your-whatsapp-token"
WHATSAPP_PHONE_ID="your-phone-id"

# ---------------------------------------------------------------------------
# Meta (Instagram / Messenger) — canal de mensajería y verificación de webhook
# META_VERIFY_TOKEN: cadena arbitraria que configurás en el panel de Meta y que
# se compara (timing-safe) en el handshake GET del webhook.
# META_APP_SECRET: firma HMAC de los webhooks entrantes (POST) para validarlos.
# ---------------------------------------------------------------------------
META_VERIFY_TOKEN="your-meta-verify-token"
META_APP_SECRET="your-meta-app-secret"

# ---------------------------------------------------------------------------
# Twilio — canal de voz (llamadas)
# ---------------------------------------------------------------------------
TWILIO_ACCOUNT_SID="your-twilio-sid"
TWILIO_AUTH_TOKEN="your-twilio-auth"
TWILIO_PHONE_NUMBER="+1234567890"
# Asistente de llamadas por voz (webhook Twilio → POST /api/voice/incoming)
VOICE_LANGUAGE="es-MX"           # idioma STT/TTS (es-MX, es-AR, es-ES, en-US, ...)
VOICE_TTS_VOICE="Polly.Mia"      # voz de Amazon Polly soportada por Twilio
# Negocio por defecto si el número entrante no coincide con ningún Business
DEFAULT_VOICE_BUSINESS_ID=""

# ---------------------------------------------------------------------------
# Resend — emails transaccionales
# ---------------------------------------------------------------------------
RESEND_API_KEY="re_..."
EMAIL_FROM="Local B <noreply@localb.app>"

# ---------------------------------------------------------------------------
# Supabase — referencia del proyecto (usada por la CLI / Admin API)
# ---------------------------------------------------------------------------
SUPABASE_PROJECT_REF="your-supabase-project-ref"

# ---------------------------------------------------------------------------
# Sentry — error tracking
# ---------------------------------------------------------------------------
SENTRY_DSN="https://examplePublicKey@o0.ingest.sentry.io/0"

# ---------------------------------------------------------------------------
# Stripe — procesamiento de pagos y suscripciones
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY="sk_test_your-stripe-secret-key"
STRIPE_WEBHOOK_SECRET="whsec_your-stripe-webhook-secret"

# ---------------------------------------------------------------------------
# Reservas públicas — verificación de teléfono por OTP (WhatsApp)
# Si es "true", la reserva pública exige un código OTP válido (requiere Twilio
# configurado). Cualquier otro valor la deja deshabilitada.
# ---------------------------------------------------------------------------
PUBLIC_BOOKING_REQUIRE_OTP="false"

# ---------------------------------------------------------------------------
# Seguridad de webhooks — SOLO desarrollo/test.
# Si es "true", se SALTEA la validación de firma de los webhooks (Twilio, Meta).
# NUNCA la actives en producción: dejala sin setear o en "false".
# ---------------------------------------------------------------------------
# SKIP_WEBHOOK_SIGNATURE_VALIDATION="false"
