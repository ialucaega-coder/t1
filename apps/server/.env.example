# apps/server/.env.example
# Variables de entorno del backend Express (apps/server).
# Copia este archivo a ".env" y completa los valores reales.
# NUNCA subas el archivo ".env" real al control de versiones.

# ---------------------------------------------------------------------------
# Base de datos (Prisma / PostgreSQL)
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://user:password@localhost:5432/localb?schema=public"

# ---------------------------------------------------------------------------
# Redis — cache y sesiones (uso futuro)
# ---------------------------------------------------------------------------
REDIS_URL="redis://localhost:6379"

# ---------------------------------------------------------------------------
# Autenticacion — debe coincidir con NEXTAUTH_SECRET del frontend (apps/web)
# porque ambos servicios firman/verifican el mismo JWT.
# Generar con: openssl rand -base64 32
# ---------------------------------------------------------------------------
NEXTAUTH_SECRET="your-secret-here"

# ---------------------------------------------------------------------------
# CORS / Socket.io — origen permitido del frontend
# ---------------------------------------------------------------------------
FRONTEND_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Servidor
# ---------------------------------------------------------------------------
PORT=4000
NODE_ENV=development

# ---------------------------------------------------------------------------
# Proveedor de IA por defecto (chatbot / asistente)
# Valores soportados: "anthropic" | "openai"
# ---------------------------------------------------------------------------
AI_PROVIDER="anthropic"
ANTHROPIC_API_KEY="your-anthropic-key"
ANTHROPIC_MODEL="claude-sonnet-4-5"
OPENAI_API_KEY="your-openai-key"
OPENAI_MODEL="gpt-4o-mini"

# ---------------------------------------------------------------------------
# Telegram Bot — canal de reservas via Telegram
# ---------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN="your-telegram-bot-token"

# ---------------------------------------------------------------------------
# WhatsApp Business API — canal de reservas via WhatsApp
# ---------------------------------------------------------------------------
WHATSAPP_TOKEN="your-whatsapp-token"
WHATSAPP_PHONE_ID="your-phone-id"

# ---------------------------------------------------------------------------
# Twilio — canal de voz (llamadas)
# ---------------------------------------------------------------------------
TWILIO_ACCOUNT_SID="your-twilio-sid"
TWILIO_AUTH_TOKEN="your-twilio-auth"
TWILIO_PHONE_NUMBER="+1234567890"
