# apps/server/.env.example
# Variables de entorno del backend Express (apps/server).
# Copia este archivo a ".env" y completa los valores reales.
# NUNCA subas el archivo ".env" real al control de versiones.

# ---------------------------------------------------------------------------
# Base de datos (Prisma / PostgreSQL)
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://user:password@localhost:5432/localb?schema=public"
# Conexion directa (sin pooler) — usada por Prisma para migraciones.
DIRECT_URL="postgresql://user:password@localhost:5432/localb?schema=public"

# ---------------------------------------------------------------------------
# Redis — cache y sesiones (uso futuro)
# ---------------------------------------------------------------------------
REDIS_URL="redis://localhost:6379"

# ---------------------------------------------------------------------------
# Autenticacion — debe coincidir con NEXTAUTH_SECRET del frontend (apps/web)
# porque ambos servicios firman/verifican el mismo JWT.
# Generar con: openssl rand -base64 32
# ---------------------------------------------------------------------------
NEXTAUTH_SECRET="your-secret-here"

# ---------------------------------------------------------------------------
# CORS / Socket.io — origen permitido del frontend
# ---------------------------------------------------------------------------
FRONTEND_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Servidor
# ---------------------------------------------------------------------------
PORT=4000
NODE_ENV=development

# ---------------------------------------------------------------------------
# Proveedor de IA por defecto (chatbot / asistente)
# Valores soportados: "anthropic" | "openai"
# ---------------------------------------------------------------------------
AI_PROVIDER="anthropic"
ANTHROPIC_API_KEY="your-anthropic-key"
ANTHROPIC_MODEL="claude-sonnet-4-5"
OPENAI_API_KEY="your-openai-key"
OPENAI_MODEL="gpt-4o-mini"

# ---------------------------------------------------------------------------
# Telegram Bot — canal de reservas via Telegram
# ---------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN="your-telegram-bot-token"

# ---------------------------------------------------------------------------
# WhatsApp Business API — canal de reservas via WhatsApp
# ---------------------------------------------------------------------------
WHATSAPP_TOKEN="your-whatsapp-token"
WHATSAPP_PHONE_ID="your-phone-id"

# ---------------------------------------------------------------------------
# Twilio — canal de voz (llamadas)
# ---------------------------------------------------------------------------
TWILIO_ACCOUNT_SID="your-twilio-sid"
TWILIO_AUTH_TOKEN="your-twilio-auth"
TWILIO_PHONE_NUMBER="+1234567890"
# Asistente de llamadas por voz (webhook Twilio → POST /api/voice/incoming)
VOICE_LANGUAGE="es-MX"           # idioma STT/TTS (es-MX, es-AR, es-ES, en-US, ...)
VOICE_TTS_VOICE="Polly.Mia"      # voz de Amazon Polly soportada por Twilio
# Negocio por defecto si el número entrante no coincide con ningún Business
DEFAULT_VOICE_BUSINESS_ID=""

# ---------------------------------------------------------------------------
# Resend — emails transaccionales
# ---------------------------------------------------------------------------
RESEND_API_KEY="re_..."
EMAIL_FROM="Local B <noreply@localb.app>"

# ---------------------------------------------------------------------------
# Supabase — referencia del proyecto (usada por la CLI / Admin API)
# ---------------------------------------------------------------------------
SUPABASE_PROJECT_REF="your-supabase-project-ref"

# ---------------------------------------------------------------------------
# Sentry — error tracking
# ---------------------------------------------------------------------------
SENTRY_DSN="https://examplePublicKey@o0.ingest.sentry.io/0"

# ---------------------------------------------------------------------------
# Stripe — procesamiento de pagos y suscripciones
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY="sk_test_your-stripe-secret-key"
STRIPE_WEBHOOK_SECRET="whsec_your-stripe-webhook-secret"
