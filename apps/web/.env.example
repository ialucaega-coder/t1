# apps/web/.env.example
# Variables de entorno del frontend Next.js (apps/web).
# Copia este archivo a ".env" o ".env.local" y completa los valores reales.
# NUNCA subas el archivo ".env" real al control de versiones.

# ---------------------------------------------------------------------------
# Base de datos (Prisma) — usada por Server Components / Route Handlers
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://user:password@localhost:5432/localb?schema=public"

# ---------------------------------------------------------------------------
# NextAuth — autenticacion
# ---------------------------------------------------------------------------
# Secreto usado para firmar cookies/JWT de sesion. Generar con:
#   openssl rand -base64 32
NEXTAUTH_SECRET="your-secret-here"
# URL publica donde corre el frontend (debe coincidir con el dominio real en prod).
NEXTAUTH_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# API — URL del backend Express (apps/server) consumida desde el cliente
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_URL="http://localhost:4000"

# ---------------------------------------------------------------------------
# Entorno
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
